[sub_resource type="GDScript" id="GDScript_dfnyt"]
resource_name = "HUDControl"
script/source = "extends Control

var life = 100
@onready var healthbar = $Health
@onready var coorlabel = $horizontal/Coor
@onready var timelabel = $horizontal/Time

func _ready() -> void:
	GAMESTATE.health_act.connect(_on_health_changed)
	_on_health_changed(GAMESTATE.stats[\"health\"])

func _on_health_changed(new_health):
	print(\"RECEIV: \", new_health)
	life = new_health
	healthbar.value = life

func _process(_delta):
	coorlabel.text = GAMESTATE.coor
	timelabel.text = \"%02d:%02d\" % [GAMESTATE.hour, GAMESTATE.minute]
"

