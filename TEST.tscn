[sub_resource type="GDScript" id="GDScript_7vw07"]
script/source = "extends Node

@onready var vane = $\"../interaction/Characters/CHARACTER\"
@onready var rabi = $\"../interaction/Characters/CHARACTER2\"
@onready var mika = $\"../interaction/Characters/CHARACTER3\"

func _ready() -> void:
	while true:
		await rabi.left(1)
		await vane.right(2)
		await rabi.right(1)
		await mika.up(1)
		await mika.right(1)
		await mika.down(1)
		await mika.left(1)
"

