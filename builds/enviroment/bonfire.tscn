[sub_resource type="GDScript" id="GDScript_qp3qs"]
resource_name = "bonfireControl"
script/source = "extends StaticBody2D

@onready var fire = $switch

func _areaEntered(body) -> void:
	var entered = true
	if body.name == 'PLAYER':
		while entered:
			var am = -1
			GAMESTATE.healthAmount(am)
			await get_tree().create_timer(2).timeout
			am -= -1
	else:
		entered = false
		return

func _process(delta: float):
	if GAMESTATE.hour >= 6 and GAMESTATE.hour <= 1:
		fire.hide()
	else:
		fire.show()
"

